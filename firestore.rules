rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminRole() {
      return signedIn() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['superadmin', 'admin', 'moderator'];
    }
    function superAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /nicknames/{nicknameId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string;
      allow update, delete: if signedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /userProfiles/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'player';
      allow read: if signedIn() && (request.auth.uid == uid || adminRole());
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if superAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow create, update, delete: if superAdmin();
    }

    match /adminQuestions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if adminRole();
    }
    match /externalGames/{id} {
      allow read: if signedIn();
      allow create, update, delete: if adminRole();
    }
  }
}
